# Copy this file to .env and fill in the values. Never commit .env.
# Bot token from the Discord Developer Portal (Bot tab -> Reset Token). Secret.
DISCORD_TOKEN=
# Application ID from General Information. Not secret.
DISCORD_CLIENT_ID=
# Test server ID: commands registered here appear instantly. Leave empty to register globally.
DISCORD_GUILD_ID=
# ID of the Storyteller role (right-click the role -> Copy Role ID, with Developer Mode on).
# Only this role and server admins can use /session, /drama (except show), answer a Devil's Bargain
# and change another player's Quickening. Leave empty to allow server admins only.
STORYTELLER_ROLE_ID=
# Where the SQLite file lives. On Railway point this to the mounted volume, e.g. /data/elder-bot.db
DATABASE_PATH=./data/elder-bot.db
