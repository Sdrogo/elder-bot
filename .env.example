# Copy this file to .env and fill in the values. Never commit .env.
# Bot token from the Discord Developer Portal (Bot tab -> Reset Token). Secret.
DISCORD_TOKEN=
# Application ID from General Information. Not secret.
DISCORD_CLIENT_ID=
# Test server ID: commands registered here appear instantly. Leave empty to register globally.
DISCORD_GUILD_ID=
# Where the SQLite file lives. On Railway point this to the mounted volume, e.g. /data/elder-bot.db
DATABASE_PATH=./data/elder-bot.db
