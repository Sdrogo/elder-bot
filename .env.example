# Copy this file to .env and fill in the values. Never commit .env.
# Bot token from the Discord Developer Portal (Bot tab -> Reset Token). Secret.
DISCORD_TOKEN=
# Application ID from General Information. Not secret.
DISCORD_CLIENT_ID=
# Test server ID: commands registered here appear instantly. Leave empty to register globally.
DISCORD_GUILD_ID=
# Where the SQLite file lives. With Docker Compose this is already set to /data/elder-bot.db.
DATABASE_PATH=./data/elder-bot.db

# Web panel (optional). Leave empty to run the bot without it.
# Public address of the panel, without a trailing slash, e.g. https://elder.example.com
PANEL_URL=
# OAuth2 Client Secret from the Developer Portal (OAuth2 tab). Secret.
# Also add <PANEL_URL>/callback under OAuth2 -> Redirects.
DISCORD_CLIENT_SECRET=
# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels). Secret.
TUNNEL_TOKEN=
# Starts the cloudflared container together with the bot. Leave empty without a panel.
COMPOSE_PROFILES=
